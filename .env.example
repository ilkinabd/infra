# Global Service Domains, Protocols, Repositories & Branches
FRONT_DOMAIN=dev.lobbym.com
FRONT_PROTOCOL=https
FRONT_REPO=git@bitbucket.org:myavuz85/dev.lobbym.com.git
FRONT_BRANCH=master

API_DOMAIN=devapi.lobbym.com
API_PROTOCOL=https
API_REPO=git@bitbucket.org:myavuz85/dev.api.lobbym.com.git
API_BRANCH=ilkin

ADMIN_DOMAIN=devadmin.lobbym.com
ADMIN_PROTOCOL=https
ADMIN_REPO=git@bitbucket.org:myavuz85/dev.admin.lobbym.com.git
ADMIN_BRANCH=ilkin

REPORT_DOMAIN=devreport.lobbym.com
REPORT_PROTOCOL=https
REPORT_REPO=git@bitbucket.org:myavuz85/dev.report.lobbym.com.git
REPORT_BRANCH=master

SOCKET_DOMAIN=devsocket.lobbym.com
SOCKET_PROTOCOL=https

# Note: Scraper does not need a domain because it runs as a background worker.

# ==========================================
# 1. API SERVICE CONFIGURATIONS (API_ prefix)
# ==========================================
API_APP_NAME=LobbymAPI
API_APP_ENV=production
API_APP_KEY=
API_APP_DEBUG=false
API_APP_URL=https://devapi.lobbym.com
API_LOG_CHANNEL=custom_rotating
API_LOG_LEVEL=debug
API_DB_CONNECTION=pgsql
API_DB_HOST=lobbym-postgres
API_DB_PORT=5432
API_DB_DATABASE=lobbym
API_DB_USERNAME=postgres
API_DB_PASSWORD=postgres
API_JWT_SECRET=

# ==========================================
# 2. ADMIN SERVICE CONFIGURATIONS (ADMIN_ prefix)
# ==========================================
ADMIN_APP_NAME=LobbymAdmin
ADMIN_APP_ENV=production
ADMIN_APP_KEY=
ADMIN_APP_DEBUG=false
ADMIN_APP_URL=https://devadmin.lobbym.com
ADMIN_LOG_CHANNEL=custom_rotating
ADMIN_LOG_LEVEL=debug
ADMIN_DB_CONNECTION=pgsql
ADMIN_DB_HOST=lobbym-postgres
ADMIN_DB_PORT=5432
ADMIN_DB_DATABASE=lobbym
ADMIN_DB_USERNAME=postgres
ADMIN_DB_PASSWORD=postgres

# ==========================================
# 3. REPORT SERVICE CONFIGURATIONS (REPORT_ prefix)
# ==========================================
REPORT_APP_NAME=LobbymReport
REPORT_APP_ENV=production
REPORT_APP_KEY=
REPORT_APP_DEBUG=false
REPORT_APP_URL=https://devreport.lobbym.com
REPORT_LOG_CHANNEL=custom_rotating
REPORT_LOG_LEVEL=debug
REPORT_DB_CONNECTION=pgsql
REPORT_DB_HOST=lobbym-postgres
REPORT_DB_PORT=5432
REPORT_DB_DATABASE=lobbym
REPORT_DB_USERNAME=postgres
REPORT_DB_PASSWORD=postgres

# ==========================================
# 4. FRONTEND CONFIGURATIONS (FRONT_ prefix)
# ==========================================
FRONT_LARAVEL_API_URL=https://devapi.lobbym.com/api
FRONT_NEXT_PUBLIC_LARAVEL_URL=https://devapi.lobbym.com
FRONT_NEXT_PUBLIC_BASE_URL=https://dev.lobbym.com
FRONT_NEXT_PUBLIC_SOCKET_URL=https://devsocket.lobbym.com
