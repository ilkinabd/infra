# HTTP redirect to HTTPS for secured domains
__REDIRECT_BLOCK__

# Frontend (Next.js)
server {
    listen __FRONT_LISTEN_PORT__;
    server_name __FRONT_DOMAIN__;

    __FRONT_SSL_CONFIG__

    location / {
        proxy_pass http://lobbym-front:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# API Backend (Laravel via FastCGI)
server {
    listen __API_LISTEN_PORT__;
    server_name __API_DOMAIN__;

    __API_SSL_CONFIG__

    root /var/www/dev.api.lobbym.com/public;
    index index.php;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass lobbym-api-php:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}

